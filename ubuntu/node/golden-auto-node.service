# Node service for node.mygoldenauto.net, installed by ubuntu/node/setup-root.sh. Listens on localhost only;
# Nginx forwards /api/node/ to it. Node comes from mark's nvm (default alias) via run-node.sh.
[Unit]
Description=Golden Auto Node service (node.mygoldenauto.net)
After=network.target

[Service]
Type=simple
User=mark
Group=mark
WorkingDirectory=/srv/golden-auto-node/node
Environment=NVM_DIR=/home/mark/.nvm
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4351
ExecStart=/srv/golden-auto-node/ubuntu/node/run-node.sh
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target

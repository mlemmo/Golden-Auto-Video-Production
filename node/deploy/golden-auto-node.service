# Template, not installed yet. Copy to /etc/systemd/system/ when the Node service goes onto a server.
# Adjust WorkingDirectory/User per environment (e.g. /srv/golden-auto-staging/node for staging, port 4351).
[Unit]
Description=Golden Auto Node service
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/srv/golden-auto/node
Environment=HOST=127.0.0.1
Environment=PORT=4350
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target

# /opt/goldenauto-video/.env  (chmod 600 — keep private)
ANTHROPIC_API_KEY=
SCRIPT_MODEL=claude-sonnet-5-5

HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
# avatar = HeyGen video avatar; talking_photo = photo avatar made from a still image (PNG/JPG)
HEYGEN_AVATAR_TYPE=talking_photo
HEYGEN_VOICE_ID=

SHOTSTACK_API_KEY=
# stage = free watermarked test renders; change to v1 (with your production key) when happy
SHOTSTACK_ENV=stage

# optional background music (public mp3 URL you have rights to)
MUSIC_URL=

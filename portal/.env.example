# LotSpotlight portal settings. Copy to .env (never committed) and fill in.
NODE_ENV=production
# This API's own address (https gives a secure sign-in cookie).
APP_URL=https://api.lotspotlight.com
# The static customer site(s) allowed to call this API, e.g. https://lotspotlight.com,https://www.lotspotlight.com
CORS_ORIGINS=
# Behind Nginx on our server.
HOST=127.0.0.1
PORT=3000
DATABASE_URL=mysql://user:pass@localhost:3306/lotspotlight
# Only for `npm test`: a separate, empty database the tests may wipe.
TEST_DATABASE_URL=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=          # 32-byte base64
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=            # pin a current version
WORKER_SHARED_SECRETS=         # workerId:secret,workerId:secret (each secret at least 32 characters)
UPLOAD_DIR=                    # car photos customers upload; default: uploads/ next to package.json
MAIL_FROM=no-reply@lotspotlight.com
